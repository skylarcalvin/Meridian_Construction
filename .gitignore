.env
.env.*
*.pat
*.token
*_secret*
*credentials*
*.key
.fabric/
# any file you stash a token in
token.txt
secrets.*

# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.ipynb_checkpoints/

# ─── Virtual environments ───────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Generated / local data (pipeline reproduces this; don't commit) ─
construction_raw/
*.csv
*.parquet
/data/
/output/
spark-warehouse/

